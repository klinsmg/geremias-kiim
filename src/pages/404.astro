---
// Página 404 — estrutura seguindo a referência indicada pelo cliente (404 da
// Hostinger): marca no topo, título e botão centrados, um painel com convite
// e imagem, e o rodapé do site com os links legais. Identidade visual do próprio site.
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import HeaderSimples from "../components/HeaderSimples.astro";
import Footer from "../components/Footer.astro";
import goldenBalayage from "../assets/prints/golden-balayage.jpg";
import { whatsappLink } from "../data/contact";

const whatsapp = whatsappLink("Olá Geremias, gostaria de pedir um orçamento ✨");
---

<Layout
  title="Página não encontrada | Geremias Kiim"
  description="A página que procura não existe ou mudou de endereço."
  noindex
>
  <HeaderSimples />
  <main id="main" class="mx-auto max-w-6xl px-5 pb-16 md:pb-24">
    <div class="mx-auto max-w-3xl py-16 text-center md:py-24">
      <h1 class="text-balance font-display text-4xl text-[color:var(--color-texto)] sm:text-5xl md:text-6xl">
        Esta página não foi encontrada
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-[color:var(--color-texto)]/70">
        A ligação pode estar partida ou a página pode ter mudado de endereço. Volte ao início para ver o trabalho do Geremias.
      </p>
      <a
        href="/"
        class="hover-lift mt-9 inline-flex min-h-11 items-center rounded-full bg-[color:var(--color-destaque)] px-8 py-3.5 text-sm font-medium text-white"
      >
        Voltar ao início
      </a>
    </div>

    <div class="grid overflow-hidden rounded-2xl bg-[color:var(--color-fundo)]/40 md:grid-cols-[1.2fr_1fr]">
      <div class="flex flex-col justify-center px-6 py-10 sm:px-12 md:py-14">
        <h2 class="text-balance font-display text-3xl text-[color:var(--color-texto)] sm:text-4xl">Veio pela cor?</h2>
        <p class="mt-3 max-w-md text-[color:var(--color-texto)]/70">
          Loiros naturais, balayage e correção de cor, em Santos, Lisboa. O orçamento é feito à medida, pelo WhatsApp.
        </p>
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-11 items-center self-start text-sm font-medium text-[color:var(--color-destaque)] underline underline-offset-4"
        >
          Peça seu orçamento no WhatsApp
        </a>
      </div>
      <Image
        src={goldenBalayage}
        alt="Resultado de coloração Golden Balayage"
        class="h-64 w-full object-cover md:h-full md:max-h-80"
        widths={[480, 640, 960]}
        sizes="(min-width: 768px) 30rem, 100vw"
        loading="eager"
      />
    </div>

  </main>
  <Footer />
</Layout>
