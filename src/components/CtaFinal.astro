---
import { whatsappLink } from "../data/contact";

const whatsapp = whatsappLink("Olá Geremias, vamos transformar meu cabelo? ✨");
---

<section class="foco-claro bg-[color:var(--color-destaque)] py-20 text-center text-white md:py-24">
  <div data-reveal class="mx-auto max-w-2xl px-5">
    <span class="glifo-assinatura text-2xl text-white/60" aria-hidden="true">✳</span>
    <h2 class="text-balance mt-4 font-display text-3xl sm:text-4xl md:text-5xl">Vamos transformar seu cabelo?</h2>
    <p class="mt-4 text-white/80">
      Sem tabela de preços fixa — cada orçamento é pensado pra você, direto no WhatsApp.
    </p>
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="hover-lift mt-8 inline-flex min-h-11 items-center rounded-full bg-white px-8 py-4 text-sm font-medium text-[color:var(--color-destaque)]"
    >
      Peça seu orçamento agora
    </a>
    <p class="mt-8 font-display text-lg italic text-white/70">— Geremias</p>
  </div>
</section>
