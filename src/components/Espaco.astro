---
import { Image } from "astro:assets";
import mapaSantos from "../assets/prints/mapa-santos.jpg";
import { whatsappLink, phoneNumber } from "../data/contact";

const whatsapp = whatsappLink("Olá Geremias, quero agendar um horário");
---

<section id="espaco" class="mx-auto max-w-6xl px-5 py-20 md:py-28">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
    <div data-reveal>
      <div class="divider-gold mb-6 justify-start"><span></span></div>
      <h2 class="text-balance font-display text-3xl text-[color:var(--color-texto)] sm:text-4xl md:text-5xl">
        Solo Concept &bull; Beauty Coworking
      </h2>
      <p class="mt-5 max-w-lg text-[color:var(--color-texto)]/75">
        Atendimento em espaço boutique de beleza no bairro de Santos, em Lisboa — cada espelho do salão
        tem nome de cidade, um mimo dos bastidores que também diz muito sobre o cuidado com detalhe que
        entra em cada atendimento. Marca teu horário e confirma tudo diretamente pelo WhatsApp.
      </p>
      <div class="mt-6 space-y-2 text-sm text-[color:var(--color-texto)]/70">
        <p>📍 Santos, Lisboa, Portugal</p>
        <p>💬 wa.me/+351 937 751 253</p>
        <p>📞 <a href={`tel:${phoneNumber}`} class="hover:text-[color:var(--color-destaque)]">+351 937 751 253</a> — também por chamada, se preferir</p>
      </div>
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hover-lift mt-8 inline-flex min-h-11 items-center rounded-full bg-[color:var(--color-destaque)] px-7 py-3.5 text-sm font-medium text-white"
      >
        Agendar pelo WhatsApp
      </a>
    </div>

    <div data-reveal>
      <!-- Mapa: imagem fixa (OpenStreetMap), sempre visível, que abre o Google
           Maps numa nova aba ao clicar. Nada do Google carrega dentro do site,
           por isso não há cookies de terceiros nem banner (ver /cookies). -->
      <a
        href="https://www.google.com/maps/search/?api=1&query=Solo+Concept+Beauty+Coworking+Santos+Lisboa"
        target="_blank"
        rel="noopener noreferrer"
        class="hover-lift group relative block overflow-hidden rounded-2xl ring-1 ring-black/5 shadow-[0_10px_30px_-18px_rgba(26,26,26,0.35)]"
      >
        <Image
          src={mapaSantos}
          alt="Mapa do bairro de Santos, em Lisboa"
          class="aspect-video w-full object-cover grayscale-[15%]"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 34rem, 100vw"
        />
        <span class="absolute bottom-3 left-3 inline-flex min-h-11 items-center rounded-full bg-[color:var(--color-destaque)] px-5 text-sm font-medium text-white">
          Abrir no Google Maps
        </span>
      </a>
      <p class="mt-3 text-xs text-[color:var(--color-texto)]/65">
        Mapa aproximado do bairro — endereço exato confirmado no WhatsApp. Dados do mapa &copy;
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">OpenStreetMap</a>.
      </p>
    </div>
  </div>
</section>
