---
import { whatsappLink } from "../data/contact";

const whatsapp = whatsappLink("Olá Geremias, gostaria de pedir um orçamento ✨");

const links = [
  { href: "#essencia", label: "Essência" },
  { href: "#tecnica", label: "Técnica" },
  { href: "#cardapio", label: "Cardápio de tons" },
  { href: "#galeria", label: "Galeria" },
  { href: "#depoimentos", label: "Depoimentos" },
  { href: "#espaco", label: "O espaço" },
];
---

<header
  x-data="{ open: false }"
  @keydown.escape.window="open = false"
  class="sticky top-0 z-50 border-b border-black/5 bg-[#fdfcfb]/90 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="#top" class="flex items-center gap-3 leading-tight">
      <span
        aria-hidden="true"
        class="glifo-assinatura flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[color:var(--color-primaria)]/40 text-lg text-[color:var(--color-primaria)]"
      >
        ✳
      </span>
      <span>
        <span class="block font-display text-xl font-semibold text-[color:var(--color-texto)]">Geremias Kiim</span>
        <span class="block text-xs tracking-widest text-[color:var(--color-primaria-texto)] uppercase">GKiim Hair &middot; Atelier de cor</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="nav-link text-sm text-[color:var(--color-texto)]/80 transition hover:text-[color:var(--color-primaria-texto)]"
        >
          {link.label}
        </a>
      ))}
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-[color:var(--color-destaque)] px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90"
      >
        WhatsApp
      </a>
    </nav>

    <button
      @click="open = !open"
      data-js-toggle
      class="flex h-11 w-11 items-center justify-center rounded-full border border-black/10 lg:hidden"
      :aria-label="open ? 'Fechar menu' : 'Abrir menu'"
      :aria-expanded="open"
      aria-controls="mobile-nav"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path x-show="!open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        <path x-show="open" x-cloak stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    x-show="open"
    x-trap.noscroll="open"
    x-cloak
    x-transition
    class="flex flex-col gap-1 border-t border-black/5 bg-[#fdfcfb] px-5 pb-5 pt-2 lg:hidden"
  >
    {links.map((link) => (
      <a href={link.href} @click="open = false" class="flex min-h-11 items-center rounded-lg px-2 py-3 text-sm text-[color:var(--color-texto)]/80">
        {link.label}
      </a>
    ))}
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 flex min-h-11 items-center justify-center rounded-full bg-[color:var(--color-destaque)] px-5 py-3 text-center text-sm font-medium text-white"
    >
      Peça seu orçamento no WhatsApp
    </a>
  </nav>
</header>
